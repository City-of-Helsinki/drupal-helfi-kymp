<?php

/**
 * @file
 * Contains installation procedure for helfi_kymp_content module.
 */

declare(strict_types=1);

use Drupal\helfi_kymp_content\Hook\MobileNoteCronHooks;
use Drupal\path_alias\Entity\PathAlias;

/**
 * Creates District nodes from Project district taxonomy terms.
 */
function helfi_kymp_content_update_9001(): void {
  _helfi_kymp_content_create_district_nodes_from_taxonomy_terms();
}

/**
 * UHF-9446: Remove all district listing paragraphs.
 */
function helfi_kymp_content_update_9002(): void {
  $storage = \Drupal::entityTypeManager()
    ->getStorage('paragraph');
  $entityIds = $storage->getQuery()
    ->condition('type', 'district_listing')
    ->accessCheck(FALSE)
    ->execute();

  foreach ($entityIds as $id) {
    $storage->load($id)->delete();
  }
}

/**
 * UHF-12838: Translate hakuvahti paths.
 */
function helfi_kymp_content_update_11001(): void {
  $paths = [
    '/hakuvahti/confirm' => [
      'en' => '/parking/confirm-vehicle-removal-alert',
      'fi' => '/pysakointi/vahvista-siirtovahti',
      'sv' => '/parkering/bekrafta-flyttningsvakten',
    ],
    '/hakuvahti/renew' => [
      'en' => '/parking/extend-vehicle-removal-alert',
      'fi' => '/pysakointi/jatka-siirtovahti',
      'sv' => '/parkering/forlang-flyttningsvakten',
    ],
    '/hakuvahti/unsubscribe' => [
      'en' => '/parking/remove-vehicle-removal-alert',
      'fi' => '/pysakointi/poista-siirtovahti',
      'sv' => '/parkering/redigera-flyttningsvakten',
    ],
  ];

  foreach ($paths as $path => $info) {
    foreach ($info as $langcode => $alias) {
      PathAlias::create([
        'path' => $path,
        'alias' => $alias,
        'langcode' => $langcode,
      ])->save();
    }
  }
}

/**
 * UHF-13553: Reindex vehicle removal notices with the new map links.
 */
function helfi_kymp_content_update_11002(): void {
  \Drupal::entityTypeManager()
    ->getStorage('search_api_index')
    ->load('mobilenote_data')
    ?->reindex();

  \Drupal::state()->deleteMultiple([
    'helfi_kymp_content.mobilenote_known_items',
    MobileNoteCronHooks::STATE_LAST_RUN,
  ]);
}

/**
 * Implements hook_update_dependencies().
 *
 * @phpstan-return array<string, array<int, array<string, int>>>
 */
function helfi_kymp_content_update_dependencies(): array {
  // Remove obsolete MobileNote index fields before helfi_base_content
  // rebuilds Views data, which fails on fields that no longer exist.
  $dependencies['helfi_base_content'][9020] = [
    'helfi_kymp_content' => 11003,
  ];
  // The 'changed_at' field storage is installed by helfi_platform_config.
  $dependencies['helfi_kymp_content'][11004] = [
    'helfi_platform_config' => 11006,
  ];
  return $dependencies;
}

/**
 * Remove phone and notes fields from the MobileNote search index.
 */
function helfi_kymp_content_update_11003(): void {
  $config = \Drupal::configFactory()
    ->getEditable('search_api.index.mobilenote_data');

  if ($config->isNew()) {
    return;
  }

  foreach (['notes', 'phone'] as $field) {
    $config->clear("field_settings.$field");
  }
  $config->save();
}

/**
 * Populate 'changed_at' from 'changed' for existing district/project nodes.
 *
 * @param array<string, mixed> $sandbox
 *   The sandbox.
 */
function helfi_kymp_content_update_11004(array &$sandbox): void {
  $storage = \Drupal::entityTypeManager()->getStorage('node');

  if (!isset($sandbox['total'])) {
    $sandbox['total'] = (int) $storage->getQuery()
      ->condition('type', ['district', 'project'], 'IN')
      ->accessCheck(FALSE)
      ->count()
      ->execute();
    $sandbox['current'] = 0;
    $sandbox['last_id'] = 0;
  }

  $nids = $storage->getQuery()
    ->condition('type', ['district', 'project'], 'IN')
    ->condition('nid', $sandbox['last_id'], '>')
    ->accessCheck(FALSE)
    ->sort('nid')
    ->range(0, 50)
    ->execute();

  if (empty($nids)) {
    $sandbox['#finished'] = 1;
    return;
  }

  foreach ($storage->loadMultiple($nids) as $node) {
    $sandbox['current']++;
    $sandbox['last_id'] = $node->id();

    if (!$node->hasField('changed_at')) {
      continue;
    }
    $changed = FALSE;

    foreach ($node->getTranslationLanguages() as $langcode => $language) {
      $translation = $node->getTranslation($langcode);

      if (!$translation->get('changed_at')->isEmpty()) {
        continue;
      }
      $translation->set('changed_at', $translation->getChangedTime());
      $changed = TRUE;
    }

    if ($changed) {
      // Keep the existing 'changed' timestamps intact.
      $node->setSyncing(TRUE);
      $node->save();
    }
  }

  $sandbox['#finished'] = $sandbox['total'] > 0
    ? min(1, $sandbox['current'] / $sandbox['total'])
    : 1;
}

/**
 * UHF-13584: Move the known MobileNote items from state to key-value.
 */
function helfi_kymp_content_update_11005(): void {
  $state = \Drupal::state();
  $knownItems = $state->get('helfi_kymp_content.mobilenote_known_items');

  if ($knownItems !== NULL) {
    \Drupal::keyValue(MobileNoteCronHooks::KEY_VALUE_COLLECTION)
      ->set(MobileNoteCronHooks::KNOWN_ITEMS, $knownItems);
    $state->delete('helfi_kymp_content.mobilenote_known_items');
  }
}

/**
 * Implements hook_uninstall().
 */
function helfi_kymp_content_uninstall(): void {
  \Drupal::keyValue(MobileNoteCronHooks::KEY_VALUE_COLLECTION)->deleteAll();
}
